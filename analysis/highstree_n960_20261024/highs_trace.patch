diff --git a/highs/mip/HighsTrace.h b/highs/mip/HighsTrace.h
new file mode 100644
index 0000000..7b3e2cd
--- /dev/null
+++ b/highs/mip/HighsTrace.h
@@ -0,0 +1,52 @@
+/* 計測用の出力 (HIGHS_TRACE を設定したときだけ、stderr へ)。
+   HIGHS_TRACE=<n>: 木のノードの行はサブ MIP の深さ n-1 まで (1 なら親だけ)。 */
+#ifndef HIGHS_MIP_HIGHS_TRACE_H_
+#define HIGHS_MIP_HIGHS_TRACE_H_
+#include <chrono>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+inline int trLevel() {
+  static int v = std::getenv("HIGHS_TRACE") ? std::atoi(std::getenv("HIGHS_TRACE")) : 0;
+  return v;
+}
+inline bool trOn() { return trLevel() > 0; }
+inline double trTime() {
+  static auto t0 = std::chrono::steady_clock::now();
+  return std::chrono::duration<double>(std::chrono::steady_clock::now() - t0)
+      .count();
+}
+inline std::vector<std::string>& trCtx() {
+  static std::vector<std::string> c;
+  return c;
+}
+inline int& trSubId() {
+  static int id = 0;
+  return id;
+}
+inline void trPrint(int level, const char* fmt, ...) {
+  std::string ctx;
+  for (const auto& s : trCtx()) {
+    if (!ctx.empty()) ctx += ">";
+    ctx += s;
+  }
+  fprintf(stderr, "TR %.3f L%d [%s] ", trTime(), level, ctx.c_str());
+  va_list ap;
+  va_start(ap, fmt);
+  vfprintf(stderr, fmt, ap);
+  va_end(ap);
+  fputc('\n', stderr);
+}
+struct TrCtxGuard {
+  bool on;
+  explicit TrCtxGuard(const std::string& s) : on(trOn()) {
+    if (on) trCtx().push_back(s);
+  }
+  ~TrCtxGuard() {
+    if (on) trCtx().pop_back();
+  }
+};
+#endif
