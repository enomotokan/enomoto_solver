+/// `n`: カットを作るときの境界 (`lo`・`up`、長さは列の数以上) で、印の列を前処理の後の境界まで広げる。
+pub(crate) fn sep_bounds(st: &RcsState, p: &MipProblem, lo: &mut [f64], up: &mut [f64]) {
+    let Some(m) = st.mask.as_ref().filter(|m| m.len() == p.n) else { return };
+    if !(flag('i') && flag('n')) {
+        return;
+    }
+    for j in 0..p.n {
+        if m[j] {
+            lo[j] = lo[j].min(p.col_lo[j]);
+            up[j] = up[j].max(p.col_up[j]);
+        }
+    }
+}
