   lpsolver.setOptionValue("dual_feasibility_tolerance",
                           mip_dual_feasibility_tolerance);
+  // 計装: HIGHS_LPOPT="opt=val;opt=val" で MIP の LP の内側の Highs の設定を変える
+  if (const char* lo = std::getenv("HIGHS_LPOPT")) {
+    std::string all(lo);
+    size_t pos = 0;
+    while (pos < all.size()) {
+      size_t e = all.find(';', pos);
+      if (e == std::string::npos) e = all.size();
+      std::string kv = all.substr(pos, e - pos);
+      size_t q = kv.find('=');
+      if (q != std::string::npos) lpsolver.setOptionValue(kv.substr(0, q), kv.substr(q + 1));
+      pos = e + 1;
+    }
+  }
