+
+void HighsLpRelaxation::cutSrcCensus(double* cnt, double* act, double* dsum,
+                                     double& modelsum) const {
+  const HighsSolution& sol = lpsolver.getSolution();
+  modelsum = 0;
+  if (!sol.dual_valid) return;
+  for (size_t i = 0; i < lprows.size(); ++i) {
+    double d = sol.row_dual[i] * sol.row_value[i];
+    if (lprows[i].origin != LpRow::kCutPool) {
+      modelsum += d;
+      continue;
+    }
+    const void* pool = &mipsolver.mipdata_->cutpools[lprows[i].cutpoolindex];
+    int s = cutsrclog::lookup(pool, lprows[i].index);
+    cnt[s] += 1;
+    if (std::fabs(sol.row_dual[i]) > 1e-9) act[s] += 1;
+    dsum[s] += d;
+  }
+}
--- /dev/null
+++ b/highs/mip/CutSrcLog.h
@@ -0,0 +1,28 @@
+// SLOW2 の計装 (ログだけ、動きは変えない): 根のカットの出どころごとの数え上げ。環境変数 HIGHS_CUTSRC_LOG で出す
+#pragma once
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <utility>
+namespace cutsrclog {
+inline thread_local int cur = -1;
+inline std::map<std::pair<const void*, int>, int> src;
+inline long gen[6] = {0, 0, 0, 0, 0, 0};
+inline int round = 0;
+inline std::FILE* dumpf() {
+  static std::FILE* f = std::getenv("HIGHS_CUTSRC_DUMP") ? std::fopen(std::getenv("HIGHS_CUTSRC_DUMP"), "w") : nullptr;
+  return f;
+}
+inline bool on() {
+  static bool v = std::getenv("HIGHS_CUTSRC_LOG") != nullptr;
+  return v;
+}
+inline int lookup(const void* pool, int idx) {
+  auto it = src.find({pool, idx});
+  return it == src.end() ? 5 : it->second;
+}
+inline const char* name(int s) {
+  static const char* n[] = {"implbd", "clique", "tableau", "path", "modk", "other"};
+  return n[(s >= 0 && s < 5) ? s : 5];
+}
+}  // namespace cutsrclog
