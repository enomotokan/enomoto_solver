--- /dev/null
+++ b/highs/mip/HighsTrace.h
@@ -0,0 +1,35 @@
+// 計測用の出力 (環境変数 HIGHS_TRACE が設定されたときだけ stderr に "TR " で始まる行を書く)
+#ifndef HIGHS_MIP_TRACE_H_
+#define HIGHS_MIP_TRACE_H_
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+inline bool htraceOn() {
+  static const bool on = std::getenv("HIGHS_TRACE") != nullptr;
+  return on;
+}
+// 呼び出し側 (RINS・RENS など) が solveSubMip の前に置く近傍の説明
+std::string& htracePendingTag();
+// 今入っているサブ MIP の説明の積み重ね (外側から)
+std::vector<std::string>& htraceTagStack();
+// 終わったばかりのサブ MIP の説明 (その解を親が受け取るときに使う)
+std::string& htraceLastSubTag();
+std::string htraceStackStr();
+// 分離のカットの書き出し (HIGHS_TRACE_CUTDUMP=<ディレクトリ>、外側の根の最初の HIGHS_TRACE_CUTDUMP_ROUNDS (1) ラウンド)
+std::string& htraceSepTag();
+int& htraceSepRound();
+inline const char* htraceCutDumpDir() { return std::getenv("HIGHS_TRACE_CUTDUMP"); }
+inline int htraceCutDumpRounds() {
+  const char* e = std::getenv("HIGHS_TRACE_CUTDUMP_ROUNDS");
+  return e ? std::atoi(e) : 1;
+}
