+// ---- 一時的な診断 (DBG_SOL) ----
+thread_local! {
+    static DBG_SOL: std::cell::RefCell<Option<Vec<f64>>> = const { std::cell::RefCell::new(None) };
+}
+pub(crate) fn dbg_sol_load(n: usize) -> bool {
+    let Ok(path) = std::env::var("ENOMOTO_DBG_PRESOLVE_SOL") else { return false };
+    let v: Vec<f64> = std::fs::read_to_string(path).unwrap().lines().map(|l| l.trim().parse().unwrap()).collect();
+    if v.len() != n { return false; }
+    DBG_SOL.with(|s| *s.borrow_mut() = Some(v));
+    true
+}
+pub(crate) fn dbg_check(label: &str, lb: &[f64], ub: &[f64], a: &FaerCsr, b: &[f64], rows: &[Vec<(usize, f64)>], rhs: &[f64], log: &[PostsolveStep]) {
+    DBG_SOL.with(|s| {
+        let s = s.borrow();
+        let Some(x) = s.as_ref() else { return };
+        let mut elim = vec![false; x.len()];
+        for st in log {
+            match st { PostsolveStep::Sub(q) => elim[q.var] = true, PostsolveStep::Forcing(f) => elim[f.var] = true, PostsolveStep::Slack(q) => elim[q.var] = true, PostsolveStep::ParallelCol(_) => {} }
+        }
+        let mut nv = 0;
+        for j in 0..x.len().min(lb.len()) {
+            if elim[j] { continue; }
+            if x[j] < lb[j] - 1e-6 || x[j] > ub[j] + 1e-6 {
+                if nv < 5 { eprintln!("DBG_SOL {label}: col {j} x={} not in [{}, {}]", x[j], lb[j], ub[j]); }
+                nv += 1;
+            }
+        }
+        for i in 0..a.nrows() {
+            let act: f64 = crate::sparse::csr_row_iter(a, i).filter(|(j, _)| !elim[*j]).map(|(j, v)| v * x[j]).sum();
+            if (act - b[i]).abs() > 1e-6 * (1.0 + b[i].abs()) {
+                if nv < 10 { eprintln!("DBG_SOL {label}: eq row {i} act={act} b={}", b[i]); }
+                nv += 1;
+            }
+        }
+        for (i, r) in rows.iter().enumerate() {
+            let act: f64 = r.iter().filter(|(j, _)| !elim[*j]).map(|&(j, v)| v * x[j]).sum();
+            if act > rhs[i] + 1e-6 * (1.0 + rhs[i].abs()) {
+                if nv < 15 { eprintln!("DBG_SOL {label}: le row {i} act={act} rhs={} row={:?}", rhs[i], r); }
+                nv += 1;
+            }
+        }
+        eprintln!("DBG_SOL {label}: violations={nv}");
+    });
+}
+pub(crate) fn dbg_x() -> Option<Vec<f64>> {
+    DBG_SOL.with(|s| s.borrow().clone())
+}
